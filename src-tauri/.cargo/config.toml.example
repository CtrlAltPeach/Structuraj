# Скопируй в config.toml, если проект лежит в синхронизируемой папке
# (OneDrive, Dropbox, Яндекс.Диск). Каталог target/ — это десятки гигабайт
# постоянно перезаписываемых объектных файлов, синхронизировать их незачем.
#
# Путь подставь свой: переменные окружения cargo здесь не раскрывает.
[build]
target-dir = "C:/Users/ИМЯ/AppData/Local/structuraj-build/target"
